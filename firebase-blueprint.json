{
  "entities": {
    "UserPreference": {
      "title": "UserPreference",
      "description": "Persistent user preferences, working hours, focus timer presets, and daily energy state.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who owns this preference document."
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "minLength": 4,
          "maxLength": 10,
          "description": "UI color theme preference."
        },
        "energyLevel": {
          "type": "string",
          "enum": ["low", "moderate", "high"],
          "minLength": 3,
          "maxLength": 12,
          "description": "Current daily energy level."
        },
        "energyNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Optional note about current capacity."
        },
        "focusDuration": {
          "type": "number",
          "description": "Default focus session length in minutes (1-240)."
        },
        "shortBreakDuration": {
          "type": "number",
          "description": "Short break length in minutes (1-60)."
        },
        "longBreakDuration": {
          "type": "number",
          "description": "Long break length in minutes (1-120)."
        },
        "workStartHour": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "description": "Daily working hours start time in HH:mm."
        },
        "workEndHour": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "description": "Daily working hours end time in HH:mm."
        },
        "weekStartsOn": {
          "type": "string",
          "enum": ["monday", "sunday"],
          "minLength": 6,
          "maxLength": 10,
          "description": "Preferred first day of the week."
        },
        "gamificationEnabled": {
          "type": "boolean",
          "description": "Whether Personal Progress XP and levels are enabled."
        },
        "remindersEnabled": {
          "type": "boolean",
          "description": "Whether browser notifications and reminders are enabled."
        },
        "topPriorities": {
          "type": "array",
          "description": "Up to 3 task IDs selected as top priorities for today."
        },
        "visibleSections": {
          "type": "array",
          "description": "Customizable Today dashboard section identifiers."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server modification timestamp."
        }
      },
      "required": [
        "ownerId",
        "theme",
        "energyLevel",
        "energyNote",
        "focusDuration",
        "shortBreakDuration",
        "longBreakDuration",
        "workStartHour",
        "workEndHour",
        "weekStartsOn",
        "gamificationEnabled",
        "remindersEnabled",
        "topPriorities",
        "visibleSections",
        "createdAt",
        "updatedAt"
      ]
    },
    "Task": {
      "title": "Task",
      "description": "Core task entity supporting scheduling, priorities, subtasks, dependencies, and energy.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 5000
        },
        "completed": {
          "type": "boolean"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "normal", "high", "urgent"],
          "minLength": 3,
          "maxLength": 10
        },
        "dueDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "startDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "scheduledStart": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "scheduledEnd": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "estimatedMinutes": {
          "type": "number"
        },
        "actualMinutes": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "projectId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "milestoneId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "tags": {
          "type": "array"
        },
        "subtasks": {
          "type": "array"
        },
        "dependencyIds": {
          "type": "array"
        },
        "recurrence": {
          "type": "string",
          "enum": ["none", "daily", "weekdays", "weekly", "monthly"],
          "minLength": 4,
          "maxLength": 12
        },
        "energyRequired": {
          "type": "string",
          "enum": ["low", "moderate", "high", "any"],
          "minLength": 3,
          "maxLength": 12
        },
        "archived": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "description",
        "completed",
        "priority",
        "dueDate",
        "startDate",
        "scheduledStart",
        "scheduledEnd",
        "estimatedMinutes",
        "actualMinutes",
        "category",
        "projectId",
        "milestoneId",
        "tags",
        "subtasks",
        "dependencyIds",
        "recurrence",
        "energyRequired",
        "archived",
        "createdAt",
        "updatedAt"
      ]
    },
    "CalendarEvent": {
