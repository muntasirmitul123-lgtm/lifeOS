          "minLength": 0,
          "maxLength": 40
        },
        "occurrenceStatus": {
          "type": "string",
          "enum": ["completed", "skipped", "missed", "none"],
          "minLength": 4,
          "maxLength": 12
        },
        "durationMinutes": {
          "type": "number"
        },
        "xpAmount": {
          "type": "number"
        },
        "sourceEntityId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "archived": {
          "type": "boolean"
        },
        "entries": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "logType",
        "title",
        "description",
        "category",
        "icon",
        "scheduleType",
        "scheduleDays",
        "targetFrequency",
        "date",
        "occurrenceStatus",
        "durationMinutes",
        "xpAmount",
        "sourceEntityId",
        "archived",
        "entries",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/user_preferences/{userId}": {
      "schema": { "$ref": "#/entities/UserPreference" },
      "description": "Per-user configuration, energy state, and preferences."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "User tasks and subtasks."
    },
    "/calendar_events/{eventId}": {
      "schema": { "$ref": "#/entities/CalendarEvent" },
      "description": "User calendar events and time blocks."
    },
    "/knowledge_items/{itemId}": {
      "schema": { "$ref": "#/entities/KnowledgeItem" },
      "description": "Second Brain inbox items, notes, ideas, and brain dumps."
    },
    "/projects_goals/{recordId}": {
      "schema": { "$ref": "#/entities/ProjectOrGoal" },
      "description": "Projects, milestones, and goals."
    },
    "/habits_logs/{logId}": {
      "schema": { "$ref": "#/entities/HabitOrLog" },
      "description": "Habits, habit occurrences, focus sessions, reviews, XP logs, and achievements."
    }
  }
}
