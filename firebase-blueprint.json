      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "logType": {
          "type": "string",
          "enum": [
            "habit",
            "habit_occurrence",
            "focus_session",
            "daily_review",
            "weekly_review",
            "xp_transaction",
            "achievement"
          ],
          "minLength": 5,
          "maxLength": 20
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000
        },
        "category": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "icon": {
          "type": "string",
          "minLength": 0,
          "maxLength": 50
        },
        "scheduleType": {
          "type": "string",
          "enum": ["daily", "weekdays", "weekly", "custom", "none"],
          "minLength": 4,
          "maxLength": 12
        },
        "scheduleDays": {
          "type": "array"
        },
        "targetFrequency": {
          "type": "number"
        },
        "date": {
