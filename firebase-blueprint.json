        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "kind": {
          "type": "string",
          "enum": ["event", "timeblock"],
          "minLength": 5,
          "maxLength": 12
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "startTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "endTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "taskId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "projectId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "category": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "location": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 3000
        },
        "recurrence": {
          "type": "string",
          "enum": ["none", "daily", "weekdays", "weekly", "monthly"],
          "minLength": 4,
          "maxLength": 12
        },
        "isFixed": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "kind",
        "date",
        "startTime",
        "endTime",
        "taskId",
        "projectId",
        "category",
        "location",
        "notes",
        "recurrence",
        "isFixed",
        "completed",
        "createdAt",
        "updatedAt"
