    "KnowledgeItem": {
      "title": "KnowledgeItem",
      "description": "Second Brain items: Inbox quick captures, structured notes, ideas, and Brain Dump transcripts.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemType": {
          "type": "string",
          "enum": ["inbox", "note", "idea", "brain_dump"],
          "minLength": 4,
          "maxLength": 12
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "content": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000
        },
        "ideaStatus": {
          "type": "string",
          "enum": ["raw", "exploring", "active", "archived", "none"],
          "minLength": 3,
          "maxLength": 12
        },
        "whyItMatters": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "nextAction": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "relatedLinks": {
          "type": "array"
        },
        "linkedProjectId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "linkedGoalId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "category": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "tags": {
          "type": "array"
        },
        "pinned": {
          "type": "boolean"
        },
        "archived": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "itemType",
        "title",
        "content",
        "ideaStatus",
        "whyItMatters",
        "nextAction",
        "relatedLinks",
        "linkedProjectId",
        "linkedGoalId",
        "category",
        "tags",
        "pinned",
        "archived",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProjectOrGoal": {
      "title": "ProjectOrGoal",
      "description": "Projects, project milestones, and short/medium/long-term goals.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recordType": {
          "type": "string",
          "enum": ["project", "milestone", "goal"],
          "minLength": 4,
          "maxLength": 12
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 5000
        },
        "status": {
          "type": "string",
          "enum": ["not_started", "active", "on_hold", "completed", "archived"],
          "minLength": 6,
          "maxLength": 15
        },
        "category": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "priority": {
          "type": "string",
          "enum": ["low", "normal", "high", "urgent"],
          "minLength": 3,
          "maxLength": 10
        },
        "startDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "targetDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "parentProjectId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "linkedGoalId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "measurableOutcome": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "progress": {
          "type": "number"
        },
        "isManualProgress": {
          "type": "boolean"
        },
        "nextAction": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "recordType",
        "name",
        "description",
        "status",
        "category",
        "priority",
        "startDate",
        "targetDate",
        "parentProjectId",
        "linkedGoalId",
        "measurableOutcome",
        "progress",
        "isManualProgress",
        "nextAction",
        "createdAt",
